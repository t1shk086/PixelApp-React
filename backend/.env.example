# Set these ONLY on the API server, NEVER in React or GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# For local development only. Production must set a long random value.
PIXELAPP_API_KEY=
# Comma-separated authorized origins
ALLOWED_ORIGINS=http://localhost:5173
# Local development uses local CSVs until Google credentials are provided.
DATA_DIR=./data

# Keep false while old Streamlit still uses the same Google Drive CSV files.
PIXELAPP_ENABLE_WRITES=false
